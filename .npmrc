# Force npm to keep its cache inside the workspace.
# Reason: this machine's default npm cache lives at D:\nodejs\node_cache, which sits
# outside the workshop sandbox and produces EPERM on every install.
cache=D:\a_my_project\CardVideo\.npm-cache

# The nvm-provided npm.ps1 wrapper fails inside the sandbox, and lifecycle scripts
# are blocked here, so keep installs script-light and prefer `--ignore-scripts`.
fund=false
audit=false
