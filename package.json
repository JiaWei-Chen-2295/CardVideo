{
  "name": "cardvideo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebAR photo cards: point a phone camera at a printed photo and a 3D screen rises off it playing a video.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "dev:https": "node --env-file-if-exists=.env scripts/dev-https.mjs",
    "dev:cert": "node scripts/dev-cert.mjs",
    "vendor": "node scripts/sync-vendor.mjs",
    "postinstall": "node scripts/sync-vendor.mjs",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "fix-video": "node scripts/fix-video.mjs",
    "inspect-video": "node scripts/inspect-video.mjs",
    "check:three": "node --no-warnings --experimental-vm-modules scripts/check-three-compat.mjs",
    "check:frontend": "node --no-warnings --experimental-vm-modules scripts/check-frontend.mjs",
    "check:server": "node scripts/smoke-test.mjs",
    "check:turso": "node --env-file=.env scripts/check-turso.mjs",
    "check:storage": "node --env-file=.env scripts/check-storage.mjs",
    "check:production": "node --env-file=.env scripts/check-production.mjs",
    "check:entrypoints": "node --env-file=.env scripts/check-entrypoints.mjs",
    "check:secrets": "node --env-file=.env scripts/check-secrets.mjs",
    "check:deploy": "npm run check:entrypoints && npm run check:production && npm run check:storage && npm run check:turso",
    "check": "npm run check:three && npm run check:frontend && npm run check:server"
  },
  "dependencies": {
    "@tursodatabase/serverless": "^1.4.0",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "mind-ar": "1.2.5",
    "three": "^0.186.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^2.8.0",
    "@tensorflow/tfjs": "^4.22.0"
  }
}
